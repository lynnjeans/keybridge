    "Back" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻る"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后退"
          }
        }
      }
    },
    "Back and forward in browsers and Finder, like on Windows." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows と同じように、ブラウザや Finder で戻る・進む。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在浏览器和访达中后退、前进，和 Windows 一样。"
          }
        }
      }
    },
    "Both" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者"
          }
        }
      }
    },
    "Both permissions are granted, so Windows Shortcut Mode can be switched on. Your habits should work now:" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の権限が許可されたので、Windows ショートカットモードをオンにできます。いつもの操作がもう使えるはずです："
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两项权限都已授权，可以开启 Windows 快捷键模式了。你的习惯现在应该都能用了："
          }
        }
      }
    },
    "Both permissions are granted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の権限が許可されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两项权限都已授权。"
          }
        }
      }
    },
    "Bring up your copy history at any time, like Win+V on Windows." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows の Win+V のように、いつでもコピー履歴を呼び出せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时调出复制历史，就像 Windows 的 Win+V。"
          }
        }
      }
    },
