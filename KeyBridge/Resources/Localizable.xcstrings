    "Off by default: also takes over ⌘ shortcuts on a Mac keyboard" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定はオフ：Mac キーボードの ⌘ ショートカットも使ってしまうため"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭：会同时占用 Mac 键盘上的 ⌘ 快捷键"
          }
        }
      }
    },
    "Off. Every key, click and scroll reaches apps unchanged." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ。キー、クリック、スクロールはすべてそのままアプリに届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭。所有按键、点击和滚动都原样传给应用。"
          }
        }
      }
    },
    "Off. Switch it on under KeyBridge in System Settings › General › Login Items & Extensions." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ。「システム設定 › 一般 › ログイン項目と機能拡張」の KeyBridge でオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未开启。请在“系统设置 › 通用 › 登录项与扩展”中的 KeyBridge 下开启。"
          }
        }
      }
    },
    "Off. Turn it on to keep what you copy, like Win+V on Windows." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ。オンにすると、Windows の Win+V のようにコピーした内容を保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭。打开后会保存你复制的内容，就像 Windows 的 Win+V。"
          }
        }
      }
    },
    "Older items are dropped once there are more; pinned items are kept" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限を超えると古い項目から削除されます。ピン留めした項目は残ります"
