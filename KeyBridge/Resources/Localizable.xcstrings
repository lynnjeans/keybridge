    "On, but the event tap could not be started. Quitting and reopening KeyBridge may help." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンですが、イベントタップを開始できませんでした。KeyBridge を終了して開き直すと直る場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启，但事件拦截未能启动。退出后重新打开 KeyBridge 可能会解决。"
          }
        }
      }
    },
    "On. %@+C, Home/End, Alt+Tab, the mouse side buttons and scroll zoom work the Windows way." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オン。%@+C、Home/End、Alt+Tab、マウスのサイドボタン、スクロールでのズームが Windows と同じように動きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
