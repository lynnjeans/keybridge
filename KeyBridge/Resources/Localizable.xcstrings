    "Advanced" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级"
          }
        }
      }
    },
    "All groups and entries go back to the preset. Your custom rules are kept." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのグループと項目がプリセットに戻ります。カスタムルールは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有分组和条目恢复为预设，自定义规则会保留。"
          }
        }
      }
    },
    "Also pressed with fn instead of Ctrl" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ctrl の代わりに fn でも押せます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以用 fn 代替 Ctrl 按"
          }
        }
      }
    },
    "Also used by %@. Only one of them takes effect." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」でも使われています。有効になるのはどちらか一方だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”也使用了它，只有其中一个会生效。"
          }
        }
      }
    },
    "An app has turned on Secure Input, which hides key presses from apps like KeyBridge — a macOS safeguard for passwords, not a fault. Mouse buttons and scrolling still work." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あるアプリがセキュア入力をオンにしたため、KeyBridge のようなアプリにはキー入力が届きません。これはパスワードを守る macOS の仕組みで、不具合ではありません。マウスボタンとスクロールは引き続き使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有应用开启了安全输入，系统会对 KeyBridge 这类应用隐藏按键——这是 macOS 保护密码的机制，不是故障。鼠标按键和滚动仍然正常。"
          }
        }
      }
    },
    "Another app already uses this shortcut. Choose a different one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このショートカットはほかのアプリが使用中です。別のものを選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他应用已占用这个快捷键，请换一个。"
          }
        }
      }
    },
    "App exceptions" : {
      "localizations" : {
