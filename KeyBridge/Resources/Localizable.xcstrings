    "Word moves stay Ctrl+← / →, since fn+← is Home on a Mac keyboard." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語単位の移動は Ctrl+← / → のままです。Mac キーボードでは fn+← が Home になるためです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按词移动仍用 Ctrl+← / →，因为 Mac 键盘上的 fn+← 就是 Home。"
          }
        }
      }
    },
    "Your rules come before the preset: where both use the same shortcut, yours wins." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
